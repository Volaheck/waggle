{
  "name": "waggle",
  "version": "0.1.0",
  "description": "Waggle — a Telegram bot that keeps the chronicle, member cards and project ratings of a group chat",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/main.ts",
    "build": "tsc -p tsconfig.json",
    "build:web": "npm --prefix web run build",
    "start": "node dist/main.js",
    "migrate": "tsx --env-file-if-exists=.env src/scripts/migrate.ts",
    "seed": "tsx --env-file-if-exists=.env src/scripts/seed.ts",
    "typecheck": "tsc -p tsconfig.test.json && npm --prefix web exec tsc -- --noEmit -p .",
    "test": "vitest run"
  },
  "type": "module",
  "dependencies": {
    "@anthropic-ai/sdk": "^1.6.0",
    "@hono/node-server": "^2.1.6",
    "grammy": "^1.46.0",
    "hono": "^4.13.17",
    "postgres": "^4.1.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  },
  "private": true,
  "engines": {
    "node": ">=22"
  }
}
