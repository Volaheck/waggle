# Token from @BotFather. In BotFather run /setprivacy → Disable so the bot sees all group messages.
BOT_TOKEN=
# Telegram user IDs of the bot owners, comma-separated. Owners approve new chats (/chats),
# get alerts and can use /link and /botstatus. Get your ID from a bot like @userinfobot.
ADMIN_TG_IDS=
# Anthropic API key. Without it the bot works, but the chronicler (cards, chronicle, rating) is off.
ANTHROPIC_API_KEY=
# Database password used by docker-compose.
POSTGRES_PASSWORD=

# polling — no domain or inbound connections needed; webhook — needs PUBLIC_URL and WEBHOOK_SECRET.
BOT_MODE=polling
# Public HTTPS address, needed for the Mini App and for webhook mode.
# PUBLIC_URL=https://waggle.example.com
# Webhook mode only: 16+ random letters, digits, "_" or "-" (e.g. from `openssl rand -hex 32`).
# WEBHOOK_SECRET=
# Mini App short name from BotFather (/newapp) — used for "Open" buttons inside the group.
# BOT_APP_SHORT_NAME=app

# The chronicler processes everything that piled up since its previous pass, every N hours, and in a busy chat sooner:
# once this many members' messages wait, but no sooner than this many minutes after the previous pass
# (answers read what it has not processed yet in full, so this keeps their prompt short; 0 messages: only the interval).
EXTRACTION_INTERVAL_HOURS=6
EXTRACTION_PASS_MESSAGES=200
EXTRACTION_MIN_GAP_MINUTES=60
# claude-sonnet-5-5 judges topics, duplicates and project signals well (~$4–7 a month for a busy chat);
# claude-haiku-5-5 is ~20x cheaper per token if the budget matters more than nuance.
EXTRACTION_MODEL=claude-sonnet-5-5
# Spending caps per calendar month for everything but the stronger model's answers below, which have a cap of their own:
# for the whole bot and for each chat (an owner can raise one chat's cap in the DB).
MONTHLY_LLM_BUDGET_USD=60
CHAT_MONTHLY_BUDGET_USD=20
# A member who mentions the bot or replies to it gets an answer from this model (~$0.001 per answer on Haiku 5.5),
# within its own monthly cap across all chats (also counted in the caps above); 0 turns answers off.
REPLY_MODEL=claude-haiku-5-5
REPLIES_MONTHLY_BUDGET_USD=10
# A member's first answers in an hour can come from a stronger model, within its own monthly cap across all chats (counted
# in no other cap, so it never silences a chat or stops its chronicler; 0 keeps every answer on REPLY_MODEL). Opus 5.5
# costs about $0.07 an answer without the prompt cache, two to three times less in a running conversation with it.
REPLY_PREMIUM_MODEL=claude-opus-5-5
REPLY_PREMIUM_PER_MEMBER_PER_HOUR=10
REPLY_PREMIUM_MONTHLY_BUDGET_USD=0
# When the same people come back to an argument the chat keeps having, the bot may speak up uninvited with one line
# from its history: at most this many times a chat a day, this many hours apart (each look at it is one call to the
# answering model, within the answers' caps). 0 turns it off; an owner turns it off for one chat in /chats.
INTERJECTIONS_PER_CHAT_PER_DAY=3
INTERJECTION_MIN_GAP_HOURS=3
# Message texts are deleted once they are this many days old and the chronicler has processed them;
# the messages themselves (author, time) stay, so links to them and activity counts keep working.
MESSAGE_RETENTION_DAYS=7
# Time zone for dates shown to users.
DISPLAY_TIMEZONE=UTC
# An owner who connects the bot to their own account (Telegram Business → Chat Automation) is shown deleted and edited
# messages from their DMs; the other side's messages are kept this many days for it, then deleted.
BUSINESS_MESSAGE_RETENTION_DAYS=30
# The same chats, both sides, are read for promises and plans to remind the owner of (kept 2 days, masked for Claude),
# within this monthly cap, also counted in MONTHLY_LLM_BUDGET_USD; 0 turns reminders off.
BUSINESS_REMINDER_MODEL=claude-haiku-5-5
BUSINESS_REMINDERS_MONTHLY_BUDGET_USD=2

# Local development only: print a secret link that opens the Mini App in a normal browser.
# DEV_BROWSER_LOGIN=true
# DEV_LOGIN_AS=your_username
