# Token from @BotFather. In BotFather run /setprivacy → Disable so the bot sees all group messages.
BOT_TOKEN=
# Telegram user IDs of the bot owners, comma-separated. Owners approve new chats (/chats),
# get alerts and can use /link and /botstatus. Get your ID from a bot like @userinfobot.
ADMIN_TG_IDS=
# Anthropic API key. Without it the bot works, but the chronicler (cards, chronicle, rating) is off.
ANTHROPIC_API_KEY=
# Database password used by docker-compose.
POSTGRES_PASSWORD=

# polling — no domain or inbound connections needed; webhook — needs PUBLIC_URL and WEBHOOK_SECRET.
BOT_MODE=polling
# Public HTTPS address, needed for the Mini App and for webhook mode.
# PUBLIC_URL=https://waggle.example.com
# Webhook mode only: 16+ random letters, digits, "_" or "-" (e.g. from `openssl rand -hex 32`).
# WEBHOOK_SECRET=
# Mini App short name from BotFather (/newapp) — used for "Open" buttons inside the group.
# BOT_APP_SHORT_NAME=app

# The chronicler processes everything that piled up since its previous pass, every N hours.
EXTRACTION_INTERVAL_HOURS=6
# claude-sonnet-5-5 judges topics, duplicates and project signals well (~$4–7 a month for a busy chat);
# claude-haiku-5-5 is ~20x cheaper per token if the budget matters more than nuance.
EXTRACTION_MODEL=claude-sonnet-5-5
# Spending caps per calendar month: for the whole bot and for each chat (an owner can raise one chat's cap in the DB).
MONTHLY_LLM_BUDGET_USD=60
CHAT_MONTHLY_BUDGET_USD=20
# A member who mentions the bot or replies to it gets an answer from this model (~$0.001 per answer on Haiku 5.5),
# within its own monthly cap across all chats (also counted in the caps above); 0 turns answers off.
REPLY_MODEL=claude-haiku-5-5
REPLIES_MONTHLY_BUDGET_USD=10
# Message texts are deleted once they are this many days old and the chronicler has processed them;
# the messages themselves (author, time) stay, so links to them and activity counts keep working.
MESSAGE_RETENTION_DAYS=7
# Time zone for dates shown to users.
DISPLAY_TIMEZONE=UTC

# Local development only: print a secret link that opens the Mini App in a normal browser.
# DEV_BROWSER_LOGIN=true
# DEV_LOGIN_AS=your_username
